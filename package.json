    "contract:build": "sh scripts/toolchain.sh stellar contract build --manifest-path contracts/invoice-escrow/Cargo.toml",
    "test:integration": "node --import tsx scripts/testnet-smoke.ts",
    "contract:deploy": "node --import tsx scripts/deploy-testnet.ts",
    "test:erp": "node --import tsx scripts/erp-testnet-smoke.ts"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.6.0",
    "@phosphor-icons/react": "^2.1.10",
